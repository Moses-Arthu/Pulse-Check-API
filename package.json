{
  "name": "pulse-check-api",
  "version": "1.0.0",
  "description": "Watchdog Sentinel – Dead Man's Switch API for CritMon Servers Inc.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "watchdog",
    "dead-mans-switch",
    "heartbeat",
    "monitoring",
    "critmon"
  ],
  "author": "CritMon Dev Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "nodemailer": "^6.9.13",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    },
    "testTimeout": 15000
  }
}
